# Required for the LangGraph supervisor and its specialist agents.
# Add a newly generated key locally. Never commit .env.
GROQ_API_KEY=your_new_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Used by the existing Chroma knowledge-base embedding component.
HF_EMBED_MODEL=BAAI/bge-small-en-v1.5

TRANSACTIONS_PATH=data/transactions.csv
BUDGETS_PATH=data/budgets.json
CHROMA_PATH=.chroma
LANGGRAPH_RECURSION_LIMIT=60
