# Copy this file to .env and add your own GroqCloud API key.
# Never commit .env or paste a real key into notebooks or source files.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Local RAG embedding model (downloaded on first run).
HF_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Local data and vector-store paths.
TRANSACTIONS_PATH=data/transactions.csv
BUDGETS_PATH=data/budgets.json
CHROMA_PATH=.chroma
